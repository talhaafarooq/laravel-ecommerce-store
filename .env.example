APP_NAME="ShopNest"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL (MAMP defaults: port 8889, root/root)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=8889
DB_DATABASE=ecommerce
DB_USERNAME=root
DB_PASSWORD=root

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@shopnest.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Storefront
SHOP_CURRENCY=USD
SHOP_CURRENCY_LOCALE=en_US
SHOP_ADMIN_EMAIL=admin@shopnest.test
SHOP_SUPPORT_EMAIL=support@shopnest.test
SHOP_SUPPORT_PHONE="+1 (555) 010-2030"
SHOP_SHIPPING_FLAT_RATE=5.00
SHOP_FREE_SHIPPING_THRESHOLD=50.00
SHOP_TAX_RATE=0
SHOP_MEDIA_DISK=public
SHOP_UNPAID_ORDER_TTL_MINUTES=60
SHOP_REVIEWS_AUTO_APPROVE=true

# Stripe (leave empty to offer Cash on Delivery only)
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# JWT (REST API) - generate with: php artisan jwt:secret
JWT_SECRET=
JWT_TTL=60
JWT_REFRESH_TTL=20160

VITE_APP_NAME="${APP_NAME}"

# Server-side rendering (run `npm run build:ssr` and `php artisan inertia:start-ssr` in production).
INERTIA_SSR_ENABLED=true
INERTIA_SSR_URL=http://127.0.0.1:13714
